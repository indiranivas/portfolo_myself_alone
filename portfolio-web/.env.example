PORT=5173
SESSION_SECRET=change-me-to-a-random-string
API_ONLY=false

# Comma-separated browser origins allowed to call the API (required on Render)
# CORS_ORIGIN=https://your-site.netlify.app,http://localhost:5173

# Gmail SMTP (use App Password, not your regular password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-16-char-app-password

# CMS admin login (override in real .env)
ADMIN_USER=indiranivas
ADMIN_PASS=change-me

# Frontend only — set in Netlify build env (not needed for local dev)
# VITE_API_URL=https://your-api.onrender.com
